# Sync job
ENABLED_SOURCES=polar
LOOKBACK_DAYS=30

# Sink: local | databricks
SINK=local
LOCAL_SINK_ROOT=data

# Databricks (Microsoft Entra ID authentication, no Databricks secrets)
DATABRICKS_HOST=
# azure-cli: local development as the `az login` user
# managed-identity: Azure, as the user-assigned identity id-wearable-sync
DATABRICKS_AUTH=azure-cli
# Client ID of the user-assigned identity (required for managed-identity only)
AZURE_CLIENT_ID=
DATABRICKS_CATALOG=wearable_sync_bronze
DATABRICKS_VOLUME=files

# Polar AccessLink
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_ACCESS_TOKEN=

# Mistral (coach, not used yet)
MISTRAL_API=
