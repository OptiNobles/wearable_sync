# Sync job
ENABLED_SOURCES=polar
LOOKBACK_DAYS=30

# Sink: local | databricks
SINK=local
LOCAL_SINK_ROOT=data

# Databricks (service principal sp_wearable_sync, OAuth secret scoped to 'files')
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_CATALOG=wearable_sync_bronze
DATABRICKS_VOLUME=files

# Polar AccessLink
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_ACCESS_TOKEN=

# Mistral (coach, not used yet)
MISTRAL_API=
